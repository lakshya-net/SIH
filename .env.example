# Server-side environment variables (copy to .env.local — never commit real keys)

# Gemini API key used by /api/ocr and /api/summarize (server-side only).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model id (defaults to gemini-2.0-flash).
# GEMINI_MODEL=gemini-2.0-flash

DATABASE_URL="postgresql://..."

# AWS S3 or any S3-compatible object storage (Cloudflare R2, MinIO, etc.)
S3_BUCKET="your-bucket-name"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"

# Required for Cloudflare R2, MinIO, or another S3-compatible provider.
# Leave empty for AWS S3.
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"

# Optional public base URL. Leave empty when using private objects.
S3_PUBLIC_BASE_URL=""
